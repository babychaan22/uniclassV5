# ── AI API Keys (server-side only) ─────────────────────────────────────────────
# These are NOT VITE_ variables — they would be baked into the JS bundle.
# Set them as Supabase secrets so they stay server-side:
#
#   supabase secrets set OPENROUTER_API_KEY=your_openrouter_key_here
#   supabase secrets set GEMINI_API_KEY=your_gemini_key_here
#
# OpenRouter (primary AI provider): https://openrouter.ai/keys (free tier)
# Gemini (fallback): https://aistudio.google.com/ (free tier, no credit card)
#
# Optional model override:
#   supabase secrets set OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1:free
#   supabase secrets set GEMINI_MODEL=gemini-2.0-flash
